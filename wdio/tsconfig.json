{
  "compilerOptions": {
    "target": "es2019",
    "strict": false,
    "module": "commonjs",
    "sourceMap": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "rootDir": "./",
    "allowJs": true,
    "outDir": "./dist",
    "types": ["node", "@wdio/globals/types", "mocha"]
  },
  "include": ["**/*.ts", "./**/*.json"],
  "exclude": ["node_modules", "dist"]
}