{
  "compilerOptions": {
    "target": "es5",
    "lib": ["es5", "dom"],
    "types": ["cypress", "node"],
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": false,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "typeRoots": [
      "./node_modules/@types",
      "./cypress/support/types"
    ],
    "paths": {
      "*": ["node_modules/*", "./cypress/support/types/*"]
    }
  },
  "include": [
    "**/*.ts",
    "cypress/support/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
